# Server-only configuration. Never expose DATABASE_URL through a VITE_* variable.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/vc_elevate_painting
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Set true only when your PostgreSQL provider requires TLS and presents a trusted certificate.
DATABASE_SSL=false

# Set true when deployed behind a trusted reverse proxy so rate limiting receives the client IP.
TRUST_PROXY=false

# Public inquiry endpoint defaults: 5 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
